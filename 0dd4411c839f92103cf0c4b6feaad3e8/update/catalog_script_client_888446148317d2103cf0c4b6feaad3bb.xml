        <name>Validate Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }
   
   var dateNow = new Date();
   
   function convertToDate(dateStr) {
      var parts = dateStr.split('/');
      return new Date(parts[2], parts[1] - 1, parts[0]); 
   }
   
   var expenseDateStr = g_form.getValue("expense_date");
   var expenseDate = convertToDate(expenseDateStr);

   if (isNaN(expenseDate.getTime())) {
      g_form.addErrorMessage("Invalid Date: Please select a valid date.");
      return;
   }
   if (expenseDate > dateNow) {
      g_form.addErrorMessage("Invalid Date: Please use a date before " + dateNow.toLocaleDateString());
      g_form.setValue("expense_date", "");
   } else {
      g_form.clearMessages();
   }
}
]]></script>
